---
import BaseLayout from '../layouts/BaseLayout.astro';
import Illustration from '../components/Illustration.astro';
import { WORKS } from '../lib/site';

const workVariants = ['work1', 'work2', 'work3', 'work4', 'work5', 'work6'] as const;
---

<BaseLayout title="作品" description="做过的一些东西 —— 工具、脚本与流程" wide>
  <section class="relative pb-12 pt-28 sm:pt-32">
    <svg
      class="sparkle"
      style="top: 108px; right: 8%; width: 26px; height: 26px;"
      viewBox="0 0 24 24"
      fill="#E8C46A"
      aria-hidden="true"
    >
      <path d="M12 0l2.6 9.4L24 12l-9.4 2.6L12 24l-2.6-9.4L0 12l9.4-2.6z"></path>
    </svg>

    <div class="mb-2 text-[12.5px] font-bold tracking-[0.14em]" style="color: var(--color-ink-400);">
      WORK
    </div>
    <h1 class="text-[2.1rem] font-extrabold tracking-tight sm:text-[2.6rem]">做过的东西</h1>
    <p class="mt-4 max-w-xl text-[15px] leading-relaxed muted">
      大部分是把自己的重复劳动变成工具 —— 省下来的时间，比工具本身更值钱。
    </p>
  </section>

  <div class="reveal-stagger grid gap-6 pb-16 sm:grid-cols-2">
    {
      WORKS.map((work, i) => (
        <article class="soft-card tilt-card group flex flex-col overflow-hidden">
          <div class="relative h-[210px] overflow-hidden" style="background-color: #F6FAF7;">
            <Illustration
              src={work.cover}
              alt={`${work.title} 插画`}
              variant={workVariants[i % workVariants.length]}
              fill
              class="transition-transform duration-700 group-hover:scale-[1.06]"
            />
          </div>
          <div class="flex flex-1 flex-col p-6">
            <div class="flex items-start justify-between gap-4">
              <div class="flex flex-wrap gap-2">
                {work.tags.map((t) => (
                  <span class="tag">{t}</span>
                ))}
              </div>
              <span class="shrink-0 text-[12px] font-bold tabular-nums faint">{work.year}</span>
            </div>
            <h2 class="mt-4 text-[17px] font-extrabold leading-snug">{work.title}</h2>
            <p class="mt-2.5 flex-1 text-[13.5px] leading-relaxed muted">{work.desc}</p>
          </div>
        </article>
      ))
    }
  </div>

  <section class="reveal pb-16">
    <div
      class="rounded-[24px] border border-dashed px-8 py-10 text-center"
      style="border-color: var(--border-strong);"
    >
      <h2 class="text-[16px] font-extrabold">还有更多在做的</h2>
      <p class="mx-auto mt-2.5 max-w-md text-[13.5px] leading-relaxed muted">
        这里只放已经能跑起来的东西。想了解具体某个怎么做，可以直接问我。
      </p>
      <div class="mt-6 flex justify-center">
        <a href="/about" class="btn-ghost">关于我</a>
      </div>
    </div>
  </section>
</BaseLayout>
