---
import BaseLayout from '../layouts/BaseLayout.astro';
import Illustration from '../components/Illustration.astro';
import { SITE, SOCIAL } from '../lib/site';

const focus = [
  { title: '把重复劳动变成工具', desc: '同一件事做第三次的时候就该写成脚本了。' },
  { title: '界面要好看，也要好用', desc: '顺手是底线，好看是基本要求。' },
  { title: '能本地就别上云', desc: '文件不离开自己的电脑，才最省心。' },
];

const stack = [
  'Python',
  'TypeScript',
  'Astro',
  'FFmpeg',
  'OpenCV',
  'Pandas',
  'Git',
  'Linux',
];
---

<BaseLayout title="关于" description={`关于 ${SITE.author}`}>
  <section class="relative pb-12 pt-28 sm:pt-32">
    <svg
      class="sparkle"
      style="top: 112px; right: 6%; width: 28px; height: 28px;"
      viewBox="0 0 24 24"
      fill="#E8C46A"
      aria-hidden="true"
    >
      <path d="M12 0l2.6 9.4L24 12l-9.4 2.6L12 24l-2.6-9.4L0 12l9.4-2.6z"></path>
    </svg>

    <div class="flex flex-col items-start gap-8 sm:flex-row sm:gap-10">
      <Illustration
        src="/illustrations/avatar.png"
        alt="追风的头像插画"
        variant="avatar"
        size={132}
        class="hero-avatar shrink-0 rounded-full shadow-lg"
        style="border: 3px solid #fff;"
      />
      <div>
        <div class="mb-2 text-[12.5px] font-bold tracking-[0.14em]" style="color: var(--color-ink-400);">
          ABOUT
        </div>
        <h1 class="text-[2.1rem] font-extrabold tracking-tight sm:text-[2.5rem]">
          我是{SITE.author}
        </h1>
        <p class="mt-5 max-w-xl text-[15.5px] leading-relaxed muted">
          平时做界面设计和前端开发，也喜欢折腾各种自动化脚本。这个站点就是我用 Astro 自己搭的，
          上面的插画是一笔一笔画的 SVG。
        </p>
        <p class="mt-4 max-w-xl text-[15px] leading-relaxed muted">
          我不太写长文。相比把想法写成文章，我更愿意把它做出来，然后放到这里。
          所以这里没有博客，只有作品和工具。
        </p>
      </div>
    </div>
  </section>

  <section class="border-t py-12" style="border-color: var(--border);">
    <h2 class="mb-7 text-[1.15rem] font-extrabold tracking-tight">我在意的三件事</h2>
    <div class="space-y-4">
      {
        focus.map((item, i) => (
          <div class="flex gap-5">
            <div
              class="grid h-9 w-9 shrink-0 place-items-center rounded-full text-[13px] font-extrabold"
              style="background-color: var(--accent-soft); color: var(--color-ink-600);"
            >
              {String(i + 1).padStart(2, '0')}
            </div>
            <div class="pt-1">
              <h3 class="text-[15px] font-extrabold">{item.title}</h3>
              <p class="mt-1.5 text-[13.5px] leading-relaxed muted">{item.desc}</p>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="border-t py-12" style="border-color: var(--border);">
    <h2 class="mb-6 text-[1.15rem] font-extrabold tracking-tight">常用的东西</h2>
    <div class="flex flex-wrap gap-2.5">
      {
        stack.map((item) => (
          <span
            class="rounded-full px-4 py-2 text-[13.5px] font-bold"
            style="background-color: rgba(255,255,255,.8); border: 1px solid var(--border); color: var(--text-mid);"
          >
            {item}
          </span>
        ))
      }
    </div>
  </section>

  <section class="border-t py-12" style="border-color: var(--border);">
    <h2 class="mb-6 text-[1.15rem] font-extrabold tracking-tight">找我</h2>
    <div class="flex flex-wrap gap-3">
      <a href={`mailto:${SOCIAL.email}`} class="btn-primary">
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <rect x="3" y="5" width="18" height="14" rx="2.5"></rect>
          <path d="m3.5 7.5 8.5 5.6 8.5-5.6"></path>
        </svg>
        {SOCIAL.email}
      </a>
      <a href={SOCIAL.github} target="_blank" rel="noopener me" class="btn-ghost">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 0-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-6 0-1.2.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.6 1.7.2 2.9.1 3.2.8.8 1.2 1.9 1.2 3.1 0 4.7-2.8 5.7-5.5 6 .4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3"></path>
        </svg>
        GitHub
      </a>
    </div>
  </section>
</BaseLayout>
