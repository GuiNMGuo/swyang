---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="页面不存在" noindex>
  <section class="relative flex min-h-[70vh] flex-col items-center justify-center py-20 text-center">
    <svg
      class="sparkle"
      style="top: 16%; left: 18%; width: 26px; height: 26px;"
      viewBox="0 0 24 24"
      fill="#E8C46A"
      aria-hidden="true"
    >
      <path d="M12 0l2.6 9.4L24 12l-9.4 2.6L12 24l-2.6-9.4L0 12l9.4-2.6z"></path>
    </svg>
    <svg
      class="sparkle s2"
      style="bottom: 22%; right: 20%; width: 18px; height: 18px;"
      viewBox="0 0 24 24"
      fill="#A8D7C3"
      aria-hidden="true"
    >
      <path d="M12 0l2.6 9.4L24 12l-9.4 2.6L12 24l-2.6-9.4L0 12l9.4-2.6z"></path>
    </svg>

    <div
      class="text-[5.5rem] font-extrabold leading-none tracking-tight"
      style="color: var(--border-strong);"
    >
      404
    </div>
    <h1 class="mt-6 text-[1.5rem] font-extrabold">这个页面不存在</h1>
    <p class="mt-3 max-w-sm text-[14px] leading-relaxed muted">
      链接可能失效了，或者地址打错了一个字。从下面这些地方继续逛吧。
    </p>
    <div class="mt-9 flex flex-wrap justify-center gap-3">
      <a href="/" class="btn-primary">回到首页</a>
      <a href="/work" class="btn-ghost">看作品</a>
      <a href="/tools" class="btn-ghost">工具箱</a>
    </div>
  </section>
</BaseLayout>
