---
import { SITE, SOCIAL } from '../lib/site';

const path = Astro.url.pathname;
---

<header class="fixed top-0 left-0 right-0 z-50 flex justify-center px-5 pt-4 sm:pt-5">
  <div class="flex w-full max-w-4xl items-center justify-between gap-3">
    <a href="/" class="flex shrink-0 items-center gap-2.5 pl-1" aria-label="返回首页">
      <span
        class="grid h-9 w-9 place-items-center rounded-full text-[15px] font-extrabold text-white"
        style="background-color: #134E3D;"
      >
        追
      </span>
      <span class="hidden text-[15px] font-extrabold tracking-tight sm:inline">{SITE.title}</span>
    </a>

    <nav class="pill-nav overflow-x-auto" aria-label="主导航">
      <a href="/" aria-current={path === '/' ? 'page' : undefined}>首页</a>
      <a href="/work" aria-current={path.startsWith('/work') ? 'page' : undefined}>作品</a>
      <a href="/tools" aria-current={path.startsWith('/tools') ? 'page' : undefined}>工具</a>
      <a href="/about" aria-current={path.startsWith('/about') ? 'page' : undefined}>关于</a>
    </nav>

    <a
      href={SOCIAL.github}
      target="_blank"
      rel="noopener me"
      aria-label="GitHub"
      class="grid h-10 w-10 shrink-0 place-items-center rounded-full transition-transform hover:scale-105"
      style="background-color: rgba(255,255,255,.72); border: 1px solid var(--border); color: var(--text-mid);"
    >
      <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor">
        <path d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 0-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-6 0-1.2.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.6 1.7.2 2.9.1 3.2.8.8 1.2 1.9 1.2 3.1 0 4.7-2.8 5.7-5.5 6 .4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3"></path>
      </svg>
    </a>
  </div>
</header>
